# Copy to .dev.vars for `npm run dev`. Use Stripe test-mode keys (sk_test_…); without them the plans page
# shows the prices but cannot take payments.
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:8787/api/billing/webhook`; optional, the return page confirms payments too.
STRIPE_WEBHOOK_SECRET=whsec_xxx
