// Cloudflare Worker: the API under /api and the built web (dist/) as static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "per-quiz",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "per-quiz",
      "database_id": "d053c8bb-bdaf-4bfc-941a-ca6468f3116a",
      "migrations_dir": "migrations"
    }
  ],
  // Free plan quota and prices (euro cents). Stripe keys are secrets: `wrangler secret put STRIPE_SECRET_KEY` and
  // `wrangler secret put STRIPE_WEBHOOK_SECRET`; locally they go in .dev.vars (see .dev.vars.example).
  "vars": {
    "FREE_DAILY_EXAMS": "3",
    "PRICE_SEMESTER_CENTS": "999",
    "PRICE_LIFETIME_CENTS": "1999"
  },
  "observability": { "enabled": true }
}
